    "node:start": "node server.js",
    "node:dev": "node --watch server.js"
  },
  "dependencies": {
    "@google/genai": "1.44.0",
    "bcryptjs": "3.0.3",
    "cors": "2.8.6",
    "dotenv": "17.3.1",
    "express": "5.2.1",
    "jsonwebtoken": "9.0.3",
    "mongoose": "9.2.4"
  }
}
