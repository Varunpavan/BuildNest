{
  "name": "nxtbuild-server",
  "version": "1.0.0",
  "description": "Backend API for NxtBuild web page builder",
  "license": "ISC",
  "type": "module",
  "scripts": {
    "start": "python3 main.py",
    "dev": "uvicorn main:app --reload --port 5050",
